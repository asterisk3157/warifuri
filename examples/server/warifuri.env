# 青井さんの家の PC の設定。トンネル(同じ機械で動く cloudflared など)の向こうから受ける。
# 1台の PC だけで使うなら、このファイルは init のひな形のままでよい。

# ハーネスから見えるサーバーの URL。自分のドメインに書き換える
WARIFURI_PUBLIC_URL=https://warifuri.example.org

# ログインしてよい人の GitHub のユーザー名。自分のものに書き換える
WARIFURI_GITHUB_USER=aoi-example

# GitHub の OAuth App の Client ID。自分で作った OAuth App のものに書き換える
# (Client Secret は secrets.env に書く)
WARIFURI_GITHUB_CLIENT_ID=<OAuth App の Client ID>

# トンネルが同じ機械から転送してくるので、loopback だけを信じる
WARIFURI_TRUST_PROXY=loopback
